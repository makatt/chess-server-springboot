# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# .env в .gitignore — секреты не попадают в репозиторий.

# --- PostgreSQL ---
POSTGRES_DB=chess
POSTGRES_USER=chess
POSTGRES_PASSWORD=change-me-before-use

# --- nginx (публикуется только на 127.0.0.1) ---
HTTP_PORT=8080

# --- образ приложения ---
# chess-server:local            -> собрать локально из Dockerfile (docker compose up --build)
# ghcr.io/makatt/chess-server-springboot:main -> готовый образ из GHCR (так делает CI/CD-деплой)
APP_IMAGE=chess-server:local
