# Сгенерировано Ansible ролью app_host. Файл создаётся один раз (force: false),
# в репозиторий не попадает. Пароль БД генерируется автоматически.
POSTGRES_DB={{ app_host_postgres_db }}
POSTGRES_USER={{ app_host_postgres_user }}
POSTGRES_PASSWORD={{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}
HTTP_PORT={{ app_host_http_port }}
APP_IMAGE={{ app_host_image }}
